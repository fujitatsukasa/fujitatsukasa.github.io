PATTERNS = {k: re.compile("|".join(v), re.I) for k, v in THEMES.items()}
SENSITIVE_RE = re.compile(r"(?i)(r-?18|nsfw|explicit|nude|naked|裸|全裸|性交|sex\b|porn|乳首|陰部|性器|射精|凌辱|강간|누드|야동|色情|裸体|性交)")
DATE_RE = re.compile(r"(?:20\d{2}[-/]\d{1,2}[-/]\d{1,2}|\d{1,2}月\d{1,2}日)")

SOURCE_LOCKS = defaultdict(threading.Lock)
SOURCE_LAST = defaultdict(float)
RATE_GAPS = {"reddit": 0.20, "bilibili": 0.25, "yahoo_x": 0.35, "wikiru": 0.40, "fivech": 0.30, "dcinside": 0.30, "niconico": 0.30}


def clean_text(s: str) -> str:
    s = BeautifulSoup(html.unescape(s or ""), "html.parser").get_text(" ", strip=True)
    return re.sub(r"\s+", " ", s).strip()


def norm(s: str) -> str:
    return unicodedata.normalize("NFKC", s or "").strip()


def safe_title(s: str, limit: int = 150) -> str:
    s = clean_text(s)
    if SENSITIVE_RE.search(s):
        return "[性的・露骨表現を含むため本文非保存]"
    return s[:limit]


def classify(texts: list[str]) -> dict[str, int]:
    counts = Counter()
    for raw in texts:
        t = norm(clean_text(raw))
        if not t:
            continue
        for name, pat in PATTERNS.items():
            if pat.search(t):
                counts[name] += 1
    return dict(counts)


def req(source: str, url: str, *, json_expected: bool = False, retries: int = 3):
    last = None
    for attempt in range(retries):
        try:
            with SOURCE_LOCKS[source]:
                gap = RATE_GAPS.get(source, 0.25)
                wait = SOURCE_LAST[source] + gap - time.monotonic()
